{
  "manifest_version": 3,
  "name": "YouTube Subses Zaman Takibi",
  "version": "1.0",
  "description": "YouTube video oynatma zamanini yerel uygulamaya (localhost) gonderir.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Subses",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "notifications"],
  "host_permissions": ["http://localhost/*"]
}
